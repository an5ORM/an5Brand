{
  "name": "an5",
  "version": "1.0.0",
  "description": "AN5 organisation brand tokens: wordmark geometry, badge shape and icon inventory.",
  "color": {
    "gradient": {
      "start": "#38BDF8",
      "end": "#6366F1"
    },
    "foreground": {
      "onBadge": "#FFFFFF"
    },
    "monochrome": {
      "onSurface": "#c5c5c5"
    }
  },
  "canvas": {
    "viewBox": 100
  },
  "badge": {
    "x": 5,
    "y": 24,
    "width": 90,
    "height": 52,
    "radius": 8
  },
  "wordmark": {
    "text": "AN5",
    "fontFamily": "DejaVu Sans Bold",
    "fontFile": "assets/fonts/AN5Wordmark-Bold.ttf",
    "licenseFile": "assets/fonts/README.md",
    "capHeight": 25,
    "baseline": 62.5,
    "centerX": 50,
    "provenance": "capHeight, baseline and centerX are measured from the approved artwork and are shared by every icon variant."
  },
  "icons": {
    "sizes": [16, 24, 32, 48, 64, 128, 256, 512],
    "defaultSize": 24,
    "wordmarkFile": "an5-{size}x{size}",
    "defaultFile": "an5",
    "activityFile": "activity.svg",
    "activitySize": 24
  }
}